# Copy to .env.local. §30 — these are SERVER-side only. Nothing here is prefixed
# NEXT_PUBLIC_ except the site URL, so the client secret can never reach the
# browser bundle.
#
# From https://developer.spotify.com/dashboard:
#   1. create an app
#   2. copy its Client ID and Client Secret
#   3. add the redirect URI below to the app's "Redirect URIs", byte for byte

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Absolute origin, used for metadataBase, OG tags, robots and sitemap (§34).
# Must be the real production URL before you share a link.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
